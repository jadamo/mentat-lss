# Ignore compiled Python files
*.pyc
__pycache__/

# Ignore local build documentation files
docs/_build/
docs/_static/
docs/_templates/

# Ignore build directories and files created by installing
build/
dist/
*.egg-info/
.DS_Store

# Data built by tests
tests/test_data/
tests/test_networks/

# Ignore other optional directories
optuna_optimization/
emulators/
*notebooks/
chains/
plots/
data/
configs/

# Ignore temporary files created by editors
*~
*.swp
settings.json
.vscode/
.pytest_cache/